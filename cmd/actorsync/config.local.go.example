//go:build local

package main

// 本地开发用的配置文件模板。
//
// 用法：
//   cp cmd/actorsync/config.local.go.example cmd/actorsync/config.local.go
//   # 按下面填好，然后
//   go run -tags local ./cmd/actorsync --limit 5
//
// 这个文件本身叫 .example 不会参与编译；复制成 config.local.go 后
// 被 .gitignore 忽略，密码不会进 git。
//
// 注意：这里的值会被环境变量覆盖，CI 上跑的时候不需要这个文件，也不用 -tags local。
func applyLocalFile(c *Config) {
	// ===== 数据源 =====
	c.TPDBAPIKey = ""     // 三围唯一来源
	c.JavStashAPIKey = "" // 生日唯一权威；日系主力
	c.StashDBAPIKey = ""  // 欧美兜底
	c.WikiEmail = ""      // 维基 API 的 User-Agent 联系邮箱，可留空

	// ===== 离线数据源 =====
	// MDCx 档案 CSV：用 scripts/export_profiles.py 生成。
	// 出生地/罩杯/身高/出道年/标签/中文名/罗马字全靠它，不填会少一大半字段。
	c.MDCxCSV = "/tmp/mdcx_profiles.csv"
	c.Gfriends = true        // 头像首选库，启动要拉 6MB 索引
	c.GfriendsIndex = ""     // 填本地 Filetree.json 就不联网拉，调试用
	c.TheActorBase = true    // 中文简介第 2 顺位（抓网页，比 API 慢）

	// ===== alist（仅 --scan-nfo 用；头像不转存）=====
	c.AlistURL = "https://alist.example.com"
	c.AlistUser = "admin"
	c.AlistPass = "your-password"

	// ===== 演员清单 =====
	// 主清单来自字典（actor_dict.csv）的全部演员，这里只是手工追加
	c.NamesFile = "actors.txt"

	// nfo 扫描（--scan-nfo 用）：从 alist 的这个目录递归读 nfo 里的演员名
	c.NFODir = "/media"

	// ===== 文件 =====
	c.DictFile = "actor_dict.csv"     // 4 列：别名,日文名,中文名,来源
	c.DictLocalFile = "data/actor_dict.local.csv"
	c.DataFile = "actors.jsonl"        // 真源，一行一个演员
	c.ManifestFile = "actors.manifest.json"
	c.XlsxFile = "actors.xlsx"

	// ===== 行为 =====
	c.Concurrency = 6 // 首铺可以调到 10
	c.Verbose = true
}
