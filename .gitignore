# 本地配置（含密码），永不入库
cmd/actorsync/config.local.go

# 构建产物
bin/
__pycache__/
*.pyc
/actorsync
*.exe

# 派生的展示表格：2 万行的二进制日更会把仓库撑爆，改由 actor-sync 挂 artifact
actors.xlsx

# 静态站生成物（由 scripts/build_site.py 从 actors.jsonl 派生，pages.yml 里现场再生成）
site/

# 临时文件
*.tmp
*.log
.DS_Store

# 质量体检的本地产物（仓库里只留脚本，报告走 artifact）
quality-report.*
.quality/

# 本地填写的 Secrets 清单，永不入库
secrets.env

# Worker 本地依赖与构建缓存
worker/node_modules/
worker/.wrangler/
