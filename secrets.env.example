# 复制成 secrets.env 后填值，然后执行：./scripts/setup-secrets.sh
# 注意：secrets.env 已在 .gitignore 里，不会被提交。
# 值里不要加引号，也不要留行尾空格。

# ===== 数据源（TPDB 与 JavStash 至少填一个）=====
TPDB_API_KEY=CHANGE_ME
JAVSTASH_API_KEY=CHANGE_ME
STASHDB_API_KEY=
DEEPL_API_KEY=
WIKI_EMAIL=

# ===== alist（必填）=====
ALIST_URL=https://alist.example.com
ALIST_USER=admin
ALIST_PASS=CHANGE_ME
# 头像存放目录
ALIST_DIR=/actors
# 直链前缀，最终头像地址 = {ALIST_PUBLIC_BASE}{ALIST_DIR}/{首字}/{名字}.jpg
ALIST_PUBLIC_BASE=https://alist.example.com/d

# nfo 扫描用：alist 里 nfo 所在的目录（build-actor-list 工作流需要）
ALIST_NFO_DIR=/media

# ===== Telegram 人工选图（可选，两个都填才启用）=====
# 这里只配 GitHub Actions 一侧。CF Worker 的四个 Secret 用 `wrangler secret put` 配，
# 见 README「方式 B：Cloudflare Worker」。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 境内直连 api.telegram.org 不通时填反代地址；--tg-serve 常驻服务尤其需要
TELEGRAM_API_BASE=

# 每轮批量最多发几个人等选择，0 = 关闭自动发图。
# 跑 --tg-serve 或启用 CF Worker webhook 时必须设 0（getUpdates 与 webhook 互斥）。
ACTORS_REVIEW_MAX=0
