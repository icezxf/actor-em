# 复制成 secrets.env 后填值，然后执行：./scripts/setup-secrets.sh
# 注意：secrets.env 已在 .gitignore 里，不会被提交。
# 值里不要加引号，也不要留行尾空格。
#
# 只写 Actions 需要的。本地跑用 cmd/actorsync/config.local.go，
# 而且是环境变量优先，这个文件跟本地无关。

# ===== 数据源（TPDB 与 JavStash 至少填一个，否则全员 no_source）=====
TPDB_API_KEY=CHANGE_ME      # 三围唯一来源
JAVSTASH_API_KEY=CHANGE_ME  # 生日唯一权威
STASHDB_API_KEY=            # 欧美兜底，可空
WIKI_EMAIL=                 # 维基 User-Agent 邮箱，可空

# ===== Telegram 人工选图（可选，两个都填才启用）=====
# 这里只配 GitHub Actions 一侧。CF Worker 的四个 Secret 用 `wrangler secret put` 配，
# 见 README「方式 B：Cloudflare Worker」。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 境内直连 api.telegram.org 不通时填反代地址；--tg-serve 常驻服务尤其需要
TELEGRAM_API_BASE=

# 每轮批量最多发几个人等选择，0 = 关闭自动发图。
# 跑 --tg-serve 或启用 CF Worker webhook 时必须设 0（getUpdates 与 webhook 互斥）。
ACTORS_REVIEW_MAX=0

# ===== 不要在这里配的 =====
# ALIST_*    仅本地 --scan-nfo 读 nfo 用，Actions 里没有对应步骤（build-actor-list 已停用）
# DEEPL_API_KEY  已移除，不再翻译英文简介
# MDCX_CSV / GFRIENDS / THEACTORBASE  由 actor-sync.yml 自己设，不要写成 Secret
