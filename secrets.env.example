# 复制成 secrets.env 后填值，然后执行：./scripts/setup-secrets.sh
# 注意：secrets.env 已在 .gitignore 里，不会被提交。
# 值里不要加引号，也不要留行尾空格。
#
# 只写 Actions 需要的。本地跑用 cmd/actorsync/config.local.go，
# 而且是环境变量优先，这个文件跟本地无关。

# ===== 数据源（TPDB 与 JavStash 至少填一个，否则全员 no_source）=====
TPDB_API_KEY=CHANGE_ME      # 三围唯一来源
JAVSTASH_API_KEY=CHANGE_ME  # 生日唯一权威
STASHDB_API_KEY=            # 欧美兜底，可空
WIKI_EMAIL=                 # 维基 User-Agent 邮箱，可空

# ===== 不要在这里配的 =====
# DEEPL_API_KEY  已移除，不再翻译英文简介
# MDCX_CSV / GFRIENDS / THEACTORBASE  由 actor-sync.yml 自己设，不要写成 Secret
